# Copy this file to .env.local (git-ignored) and fill in what you need, then restart `npm run dev`.

# Required for the library tab and the profile card (Valve needs *a* key for rate limiting; it does
# not have to belong to the account being looked up). Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional - all-time-low price badges (https://isthereanydeal.com/apps/)
ITAD_API_KEY=

# Optional - cross-device sync, poll storage, price/metacritic caches (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional - default Steam ID64 for /api/wishlist when none is passed
STEAM_ID=
